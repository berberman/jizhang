# Copy to .env under umask 077; keep it private (mode 0600).
# Setup and secret generation: docs/deployment.md#protected-configuration-and-compose
# Optional settings: docs/configuration.md. Unlisted safeguards stay enabled.

# Recommended: one HTTPS origin behind your reverse proxy.
# FRONTEND_URL needs a trailing slash. Replace the synthetic hostname.
PUBLIC_API_URL=https://ledger.example.test
FRONTEND_URL=https://ledger.example.test/
API_BASE_URL=same-origin

# Generate two independent 32-byte base64 keys; keep them stable and backed up.
JWT_SECRET_KEY=
OIDC_SECRET_KEY=

# Separate application and superuser passwords for bundled PostgreSQL.
# With an existing database, omit POSTGRES_PASSWORD and set its connection details.
PGPASSWORD=
POSTGRES_PASSWORD=

# Optional pair: creates an admin only if absent; never resets its password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

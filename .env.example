# Public template only; no usable credentials. Create a real file owner-only:
#   umask 077
#   cp .env.example .env
#   chmod 600 .env
# Edit .env privately; never commit it, print it, or print expanded Compose config.
# Generate each signing/encryption key independently, directly into that file:
#   printf '\nJWT_SECRET_KEY=' >> .env; openssl rand -base64 32 >> .env
#   printf '\nOIDC_SECRET_KEY=' >> .env; openssl rand -base64 32 >> .env
# Remove the earlier blank assignments after generation. Retain/back up both keys.
# Generate two separate database passwords directly into the protected file:
#   printf '\nPGPASSWORD=' >> .env; openssl rand -hex 32 >> .env
#   printf '\nPOSTGRES_PASSWORD=' >> .env; openssl rand -hex 32 >> .env
# Remove their earlier blank assignments too. Do not reuse either key/password.
# Compose env-file single quotes preserve literal $, #, whitespace and backslashes:
#   PGPASSWORD='synthetic $ and # punctuation example'
# This comment is not a password to use. For a literal single quote inside a
# single-quoted Compose value use \'. Unquoted/double-quoted values interpolate $;
# do not source this file as a shell script or concatenate passwords into a URI.

# Split-origin loopback example; use external HTTPS origins in production.
# API root has no trailing slash; FRONTEND_URL must end in /.
PUBLIC_API_URL=http://127.0.0.1:8080
FRONTEND_URL=http://127.0.0.1:3000/
CLIENT_ORIGINS=http://127.0.0.1:3000
# true for production, including TLS termination at an external gateway.
# false is only for explicit literal-loopback HTTP testing above.
ADMIN_COOKIE_SECURE=false
JWT_SECRET_KEY=
OIDC_SECRET_KEY=
# Optional pair; bootstrap inserts only, never resets an existing admin password.
# Admin passwords retain the existing 72-byte UTF-8 limit.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Complete provider/signup group is backend-only. Database mode rejects nonempty
# values for any of the seven managed settings, even if OIDC is disabled.
# In environment mode, provider name defaults to Authentik when empty (otherwise
# 1-100 non-control characters). Empty issuer/client/secret clears the field;
# enabled OIDC needs all three nonblank. Preserve issuer paths/trailing slash
# exactly. Client ID and secret preserve nonblank values without controls.
# Disabled mode may keep partial settings, but linked identities require retaining
# the existing issuer/client ID until explicitly unlinked. Disabling keeps local
# sign-in available. Signup flags control public signup, not existing-account login.
AUTH_CONFIG_SOURCE=database
OIDC_ENABLED=
OIDC_PROVIDER_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
LOCAL_REGISTRATION_ENABLED=
SSO_REGISTRATION_ENABLED=
# Alternative environment-owned example: REPLACE the assignments above, do not
# append contradictory modes. All three booleans must be exact true/false.
# AUTH_CONFIG_SOURCE=environment
# OIDC_ENABLED=true
# LOCAL_REGISTRATION_ENABLED=false
# SSO_REGISTRATION_ENABLED=false
# OIDC_PROVIDER_NAME=Authentik
# OIDC_ISSUER=https://id.example.test/application/o/jizhang/
# OIDC_CLIENT_ID=synthetic-jizhang-client
# OIDC_CLIENT_SECRET=
# Fill the provider-issued secret privately before enabling. This secret is not
# OIDC_SECRET_KEY. Enabled mode requires reachable valid OIDC discovery/JWKS.
# Hand back: source=database AND remove/empty all seven managed settings; the last
# committed snapshot persists. All changes take effect at backend startup only.

# Backend safeguards are always enabled, including direct launches without ingress.
# Positive ASCII decimal integers only; empty numeric settings fail startup.
# Full ranges, body classes and burst calculation: docs/deployment.md.
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
RATE_LIMIT_ACCOUNT_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_ACCOUNT_PER_MINUTE=30
RATE_LIMIT_CREDENTIAL_PER_MINUTE=10
REQUEST_AUTH_BODY_MAX_BYTES=65536
REQUEST_BODY_MAX_BYTES=1048576
REQUEST_BULK_BODY_MAX_BYTES=8388608
REQUEST_MAX_IN_FLIGHT=32
REQUEST_MAX_EXPENSIVE_IN_FLIGHT=4
RATE_LIMIT_MAX_KEYS=10000
# Opt-in forwarding trust: only actual ingress peer/chain CIDRs, at most 32.
# Empty trusts no proxy, including loopback. Keep backend private to ingress;
# CIDR trust alone does not block direct access. Never trust all client networks.
TRUSTED_PROXY_CIDRS=

# Empty DATABASE_URL uses libpq PG variables without constructing a DSN.
# A nonempty DSN/URI overrides matching PG fields, not unspecified fields.
DATABASE_URL=
PGHOST=postgres
PGPORT=5432
PGDATABASE=jizhang
PGUSER=jizhang
PGPASSWORD=
# Bundled override only; separate superuser secret, never supplied to the backend.
POSTGRES_PASSWORD=
# Remote DB: verify-full, application-owner role, actual RW hostname and CA path.
PGSSLMODE=prefer
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
PGCONNECT_TIMEOUT=10
# First-volume bootstrap only: changing these values never rotates existing DB
# credentials or migrates data. External mode requires pre-provisioned app access.

API_BIND_HOST=127.0.0.1
API_PORT=8080
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
# Leave API_BASE_URL UNSET to use PUBLIC_API_URL in Compose. Explicit empty selects
# same-origin behind an operator gateway; use only a browser-visible public URL.
# API_BASE_URL=
# Bare web image defaults empty; never use http://backend:8080 in browser config.
JIZHANG_BACKEND_IMAGE=jizhang-backend:local
JIZHANG_WEB_IMAGE=jizhang-web:local

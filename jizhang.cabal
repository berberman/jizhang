cabal-version:   3.0
name:            jizhang
version:         0.1.0.0
synopsis:        Web application for group expense management
description:
  Jizhang is a web application designed to help groups manage their expenses.

license:         MIT
license-file:    LICENSE
author:          Potato Hatsue
maintainer:      1793913507@qq.com
copyright:       2025 Potato Hatsue
build-type:      Simple
extra-doc-files: CHANGELOG.md
data-files:
  client/web/jizhang-mark.svg
  client/web/receipt-heif-worker.js
  client/web/receipt-heif.js
  client/web/vendor/libheif/corresponding-source.tar.gz
  client/web/vendor/libheif/libheif-bundle.js
  client/web/vendor/libheif/LICENSES.txt
  client/web/vendor/libheif/SOURCE.txt
  data/currencies.json
  data/receipt-extraction.json
  sql/*.sql
  ui/*.css
  ui/*.html
  ui/*.js

common opts
  ghc-options:      -Wall
  default-language: Haskell2010
  build-depends:    base

library
  import:          opts
  hs-source-dirs:  src
  autogen-modules: Paths_jizhang
  other-modules:
    Jizhang.API.Group.Projection
    Jizhang.API.Internal.Error
    Jizhang.API.Internal.Resource
    Jizhang.API.Receipt.Source
    Jizhang.API.Record.Input
    Jizhang.API.Record.Projection
    Jizhang.API.Record.Service
    Jizhang.API.User.Account
    Jizhang.API.User.Projection
    Paths_jizhang

  exposed-modules:
    Jizhang.API
    Jizhang.API.AccountAuthentication
    Jizhang.API.Admin
    Jizhang.API.Admin.Authentication
    Jizhang.API.Admin.Common
    Jizhang.API.Admin.Groups
    Jizhang.API.Admin.ReceiptAI
    Jizhang.API.Admin.ReceiptAI.Settings
    Jizhang.API.Admin.ReceiptAI.Usage
    Jizhang.API.Admin.Users
    Jizhang.API.AdminAuth
    Jizhang.API.AdminUI
    Jizhang.API.App
    Jizhang.API.Auth
    Jizhang.API.Common
    Jizhang.API.ExchangeRate
    Jizhang.API.Group
    Jizhang.API.GroupImport
    Jizhang.API.Invitation
    Jizhang.API.Logout
    Jizhang.API.OIDC
    Jizhang.API.Receipt
    Jizhang.API.ReceiptAI
    Jizhang.API.Record
    Jizhang.API.Report
    Jizhang.API.RequestProtection
    Jizhang.API.Statistics
    Jizhang.API.Types
    Jizhang.API.Types.Admin
    Jizhang.API.Types.Auth
    Jizhang.API.Types.Common
    Jizhang.API.Types.ExchangeRate
    Jizhang.API.Types.Group
    Jizhang.API.Types.Money
    Jizhang.API.Types.OIDC
    Jizhang.API.Types.Receipt
    Jizhang.API.Types.ReceiptAI
    Jizhang.API.Types.ReceiptAISettings
    Jizhang.API.Types.ReceiptAIUsage
    Jizhang.API.Types.ReceiptSummary
    Jizhang.API.Types.Record
    Jizhang.API.Types.Report
    Jizhang.API.Types.Statistics
    Jizhang.API.Types.User
    Jizhang.API.User
    Jizhang.Auth.Context
    Jizhang.Auth.Security
    Jizhang.Auth.Session
    Jizhang.Config
    Jizhang.Currency
    Jizhang.Database
    Jizhang.Database.Admin
    Jizhang.Database.AdminAuthentication
    Jizhang.Database.Auth
    Jizhang.Database.Connection
    Jizhang.Database.ExchangeRate
    Jizhang.Database.Group
    Jizhang.Database.Init
    Jizhang.Database.Receipt
    Jizhang.Database.ReceiptAI
    Jizhang.Database.Record
    Jizhang.Database.Schema
    Jizhang.Database.User
    Jizhang.ExchangeRate
    Jizhang.Money
    Jizhang.OIDC
    Jizhang.ReceiptAI.Contract
    Jizhang.ReceiptAI.Image
    Jizhang.ReceiptAI.Provider
    Jizhang.ReceiptAI.Review
    Jizhang.ReceiptAI.Runtime
    Jizhang.RecordQuery
    Jizhang.Report.Balance
    Jizhang.Report.Markdown
    Jizhang.Report.Statistics
    Jizhang.RequestProtection

  build-depends:
    , aeson
    , attoparsec
    , attoparsec-aeson
    , base64-bytestring
    , bcrypt
    , beam-core             ^>=0.10.4
    , beam-postgres         ^>=0.5.4
    , bytestring
    , cassava
    , containers
    , cookie
    , crypton
    , email-validate        >=2.3       && <2.4
    , filepath
    , http-client
    , http-client-tls
    , http-media
    , http-types
    , iproute               >=1.7       && <1.8
    , jose
    , jose-jwt              ==0.10.0
    , JuicyPixels
    , lens
    , log-base              ^>=0.12.1
    , memory
    , monad-control
    , mtl
    , network
    , network-uri
    , oidc-client           ==0.8.0.0
    , postgresql-libpq      ^>=0.11.0.0
    , postgresql-simple     ^>=0.7.0.1
    , scientific
    , servant
    , servant-auth
    , servant-auth-server
    , servant-auth-swagger
    , servant-server
    , servant-swagger
    , swagger2
    , text
    , time
    , transformers
    , transformers-base
    , uuid
    , vector
    , wai
    , wai-cors              ^>=0.2.7
    , warp

executable jizhang
  import:         opts
  main-is:        Main.hs
  ghc-options:    -threaded
  hs-source-dirs: app
  build-depends:
    , beam-postgres
    , bytestring
    , containers
    , http-client
    , http-client-tls
    , jizhang
    , log-base             ^>=0.12.1
    , postgresql-simple
    , servant-auth-server
    , text
    , unix
    , warp

test-suite jizhang-tests
  import:         opts
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  other-modules:
    AdminAuthenticationTest
    APITest
    AuthAccountTest
    AuthLogTest
    AuthSessionTest
    ConfigTest
    CurrencyTest
    DatabaseRecoveryTest
    EnvironmentAuthenticationTest
    ExchangeQuoteTest
    ExchangeRateTest
    LogoutTest
    MoneyTest
    OIDCDtoTest
    OIDCFlowTest
    OIDCProvider
    OIDCTest
    ReceiptAIProviderTest
    ReceiptAISettingsTest
    ReceiptAITest
    ReceiptAIUsageTest
    ReceiptImageTest
    ReceiptImportTest
    ReceiptSourceDatabaseTest
    ReceiptSourceTest
    RecordQueryTest
    ReportTest
    RequestProtectionCredentialTest
    RequestProtectionTest
    StatisticsTest
    Utils

  hs-source-dirs: test
  build-depends:
    , aeson
    , base64-bytestring
    , beam-postgres
    , bytestring
    , containers
    , crypton
    , http-client
    , http-types
    , iproute              >=1.7     && <1.8
    , jizhang
    , jose
    , jose-jwt             ==0.10.0
    , JuicyPixels
    , log-base             ^>=0.12.1
    , network
    , network-uri
    , postgresql-simple
    , scientific
    , servant-auth
    , servant-auth-client
    , servant-auth-server
    , servant-client
    , servant-client-core
    , servant-server
    , tasty
    , tasty-hunit
    , text
    , time
    , uuid
    , vector
    , wai
    , warp
